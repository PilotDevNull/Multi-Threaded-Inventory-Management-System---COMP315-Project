}

QWidget#DashboardPage QTableWidget#activityFeedTableWidget::item {
    background: transparent;
    border: none;
    padding: 10px 8px;
}

QWidget#DashboardPage QTableWidget#activityFeedTableWidget::item:selected {
    background: #E0F2FE;
    border-radius: 6px;
}

QWidget#DashboardPage QWidget#feedRowWidget {
