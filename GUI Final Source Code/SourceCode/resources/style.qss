}
QWidget#AnalyticsPage QFrame#chartCanvasFrame QWidget {
    background: transparent;
}
QWidget#AnalyticsPage QFrame#chartCanvasFrame QLabel,
QWidget#AnalyticsPage QFrame#revenueChartCanvasFrame QLabel,
QWidget#AnalyticsPage QFrame#failureChartCanvasFrame QLabel,
QWidget#AnalyticsPage QLabel#lastReportGeneratedLabelTitle,
QWidget#AnalyticsPage QLabel#lastReportGeneratedLabel,
QWidget#AnalyticsPage QLabel#exportReadyLabelTitle {
    background: transparent;
}
QWidget#AnalyticsPage QFrame#footerFrame {
