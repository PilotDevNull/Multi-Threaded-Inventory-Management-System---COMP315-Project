/* ─── Orders Page ─────────────────────────────────────────────────────── */

/* ── Card-level title label (replaces QGroupBox::title for Orders cards)
       This textRole is assigned to warehousesTitleLabel, consoleTitleLabel
       and manualEntryTitleLabel in orderspage.cpp. ── */
QLabel[textRole="cardTitle"] {
    background: transparent;
    color: #17263C;
    font-size: 12pt;
    font-weight: 700;
    padding: 4px 18px 2px 18px;
}

/* ── Suppress the now-empty QGroupBox placeholder title on the Orders page.
       QGroupBox[surface] normally has margin-top:28px so its ::title floats
       above the border in the gray page area.  Since we replaced it with an
       explicit QLabel inside the layout, zero out that external margin so the
       white card fills its full allocated space. ── */
QWidget#OrdersPage QGroupBox[surface="card"] {
    margin-top: 0;
    padding-top: 0;
}
QWidget#OrdersPage QGroupBox[surface="card"]::title {
    /* empty string – nothing to render; zero out any residual space */
    height: 0;
    padding: 0;
    margin: 0;
}

/* ── Transparent backgrounds for every text-role label on the Orders page.
       The global rule QWidget { background-color: #EDF2F8; } would otherwise
       paint a gray rectangle behind plain QLabels sitting on white cards.
       Badge labels (which have [badgeRole]) carry their own explicit
       background colours and are unaffected by this rule. ── */
QWidget#OrdersPage QLabel[textRole] {
    background: transparent;
}
QWidget#OrdersPage QScrollArea#ordersPageScrollArea,
QWidget#OrdersPage QWidget#ordersPageScrollContent,
QWidget#OrdersPage QWidget#ordersPageScrollAreaViewport,
QWidget#OrdersPage QSplitter#mainSplitter,
QWidget#OrdersPage QFrame#centerColumnFrame,
QWidget#OrdersPage QFrame#rightColumnFrame,
QWidget#OrdersPage QScrollArea#scrollArea,
QWidget#OrdersPage QWidget#scrollAreaWidgetContents {
    background: transparent;
    border: none;
}

/* ── Labels inside warehouse inner-cards need the same treatment.
       (w1TitleLabel / warehouse1StatusLabel / etc. have no textRole, but
       they sit on white warehouse frames so transparency is correct.) ── */
QWidget#OrdersPage QFrame[surface="warehouse"] QLabel {
    background: transparent;
}

/* ── Warehouse card buttons — compact for the narrow left column ── */
QWidget#OrdersPage QFrame[surface="warehouse"] QPushButton {
    min-height: 34px;
    font-size: 9.5pt;
    padding: 0 10px;
}

/* ── Warehouse inner card title (W1 / W2 …) ── */
QWidget#OrdersPage QFrame[surface="warehouse"] QLabel[textRole="sectionTitle"] {
    font-size: 10.5pt;
    font-weight: 700;
    color: #17263C;
}

/* ── File-path read-only input inside warehouse card ── */
QWidget#OrdersPage QFrame[surface="warehouse"] QLineEdit {
    min-height: 34px;
    font-size: 9pt;
}

/* ── Console card ── */
QWidget#OrdersPage QGroupBox#consoleGroupBox {
    min-height: 160px;
}

/* ── Search field in the console toolbar ── */
QWidget#OrdersPage QLineEdit#consoleSearchLineEdit {
    max-width: 200px;
    min-height: 34px;
}

/* ── Manual order form labels ── */
QWidget#OrdersPage QGroupBox#manualOrderGroupBox QLabel[textRole="labelTitle"] {
    font-size: 9.5pt;
    font-weight: 600;
}

/* ── Manual helper note ── */
QWidget#OrdersPage QLabel#manualHelperLabel {
    font-size: 8.8pt;
    color: #7B8798;
    padding: 0;
}

/* ── Submit Order — primary weight ── */
QWidget#OrdersPage QPushButton#submitManualOrderButton {
    font-size: 10pt;
    font-weight: 700;
}

/* ── Bottom status strip ── */
QWidget#OrdersPage QFrame#bottomStatusFrame {
    background: #FFFFFF;
    border: none;
    border-top: 1px solid #DDE6F1;
    border-radius: 0;
    min-height: 52px;
    max-height: 52px;
}
QWidget#OrdersPage QFrame#bottomStatusFrame QLabel[badgeRole] {
    min-height: 26px;
    border-radius: 10px;
    font-size: 9.2pt;
    padding: 0 12px;
}
QWidget#OrdersPage QFrame#bottomStatusFrame QLabel[textRole="labelTitle"] {
    font-size: 9pt;
    font-weight: 700;
    color: #516074;
}

/* ─── Analytics Page ──────────────────────────────────────────────────────── */

/* Collapse the empty-title external margin so cards fill their full space. */
QWidget#AnalyticsPage QGroupBox[surface="card"] {
    margin-top: 0;
    padding-top: 0;
}
QWidget#AnalyticsPage QGroupBox[surface="card"]::title {
    height: 0;
    padding: 0;
    margin: 0;
}
/* Prevent the global QWidget background bleeding through text labels on cards. */
QWidget#AnalyticsPage QLabel[textRole] {
    background: transparent;
}
QWidget#AnalyticsPage QFrame#kpiFrame1 QLabel[objectName*="ValueLabel"],
