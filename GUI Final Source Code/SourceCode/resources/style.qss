/* ============================================================
   Dashboard additions — card headers, icons, cell styling
   ============================================================ */

/* Card header title labels (replaces QGroupBox::title) */
QWidget#DashboardPage QLabel[role="cardTitle"] {
    background: transparent;
    border: none;
    color: #0F172A;
    font-size: 15px;
    font-weight: 600;
    padding: 0;
}

/* Ellipsis menu buttons on card headers */
QWidget#DashboardPage QToolButton[role="cardMenu"] {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #94A3B8;
    font-size: 18px;
    padding: 4px 8px;
    min-width: 28px;
    min-height: 24px;
}

QWidget#DashboardPage QToolButton[role="cardMenu"]:hover {
    background: #F1F5F9;
    color: #475569;
}

/* Warehouse filter combo box */
QWidget#DashboardPage QComboBox#warehouseFilterCombo {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    color: #334155;
    font-size: 12px;
    font-weight: 500;
    min-height: 28px;
    max-height: 28px;
    padding: 2px 12px;
}

QWidget#DashboardPage QComboBox#warehouseFilterCombo:hover {
    border-color: #CBD5E1;
}

QWidget#DashboardPage QComboBox#warehouseFilterCombo::drop-down {
    border: none;
    width: 20px;
}

/* Product file chip labels */
QWidget#DashboardPage QLabel[role="fileChip"] {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    color: #475569;
    font-size: 12px;
    padding: 4px 10px;
}

/* Processed pill labels */
QWidget#DashboardPage QLabel[role="processedPill"] {
    background: #EEF2FF;
    border: none;
    border-radius: 6px;
    color: #4F46E5;
    font-size: 12px;
    font-weight: 600;
    min-width: 60px;
    padding: 4px 16px;
}

QWidget#DashboardPage QLabel[role="processedPill"][processedActive="true"] {
    background: #C7D2FE;
    color: #3730A3;
}

/* Success cell: green dot + number */
QWidget#DashboardPage QLabel[role="successCell"] {
    background: transparent;
    border: none;
    color: #22C55E;
    font-size: 13px;
    font-weight: 600;
    padding: 0 4px;
}

/* Fail cell: red dot + number */
QWidget#DashboardPage QLabel[role="failCell"] {
    background: transparent;
    border: none;
    color: #EF4444;
    font-size: 13px;
    font-weight: 600;
    padding: 0 4px;
}

/* Snapshot groupbox compact horizontal strip */
QWidget#DashboardPage QGroupBox#snapshotGroupBox {
    max-height: 100px;
}

/* Snapshot vertical separator */
QWidget#DashboardPage QFrame#snapshotSep {
    background: #E2E8F0;
    border: none;
}

QWidget#DashboardPage QLabel#todayRevenueValueLabel[metricState="placeholder"] {
    color: #5A677A;
    font-size: 20pt;
    font-weight: 600;
}

/* Alternating row tint for warehouse grid (odd data rows) */
QWidget#DashboardPage QLabel[altRow="true"] {
    background: #FFFFFF;
}

