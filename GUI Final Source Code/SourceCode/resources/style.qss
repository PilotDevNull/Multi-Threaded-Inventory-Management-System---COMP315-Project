    gridline-color: transparent;
}

QWidget#DashboardPage QWidget#activityFeedViewport {
    background: #FFFFFF;
    border: none;
}

QWidget#DashboardPage QHeaderView::section,
QWidget#DashboardPage QTableCornerButton::section {
    background: #F8FAFC;
    border: none;
