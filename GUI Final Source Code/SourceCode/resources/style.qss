QWidget {
    font-family: "Segoe UI Variable Text", "Aptos", "Segoe UI", sans-serif;
    font-size: 10pt;
    color: #22324A;
    background-color: #EDF2F8;
}

QMainWindow,
QWidget#centralwidget {
    background: qradialgradient(cx:0.18, cy:0.1, radius:1.15, fx:0.18, fy:0.1, stop:0 #F9FBFF, stop:0.48 #EEF4FA, stop:1 #E7EDF5);
}

QWidget#DashboardPage,
QWidget#InventoryPage,
QWidget#OrdersPage,
QWidget#LogsPage,
QWidget#AnalyticsPage,
QWidget#SettingsPage,
QStackedWidget,
QStackedWidget > QWidget,
QScrollArea,
QScrollArea > QWidget,
QScrollArea > QWidget > QWidget,
QWidget#tablePillContainer,
QWidget#stockCell,
QWidget#productCellWidget,
QWidget#timelineItemWidget,
QWidget#chartLegendItem,
QWidget#warehouseTitleRowWidget {
    background: transparent;
}

QFrame#appShellFrame[surface="shell"] {
    background: transparent;
    border: none;
}

QFrame#sidebarFrame[surface="sidebar"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #F7FAFF, stop:1 #EEF4FB);
    border: 1px solid #DDE6F1;
    border-radius: 0px;
}

QFrame#sidebarBrandFrame[surface="sidebarBrand"] {
    background: rgba(255, 255, 255, 0.82);
    border: 1px solid #E4EBF4;
    border-radius: 24px;
}

QFrame#sidebarBrandMarkFrame {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #1E5FE9, stop:1 #4E90FF);
    border: none;
    border-radius: 18px;
}

QFrame#topBarFrame[surface="topbar"] {
    background: #FFFFFF;
    border: 1px solid #FFFFFF;
    border-radius: 0px;
}

QFrame#headerActionClusterFrame,
QFrame#topBarProfileFrame {
    background: transparent;
    border: none;
}

QFrame#topBarFrame QLabel[textRole="brandAccent"],
QFrame#topBarFrame QLabel[textRole="brandWord"],
QFrame#topBarFrame QLabel[textRole="headerTitle"],
QFrame#topBarFrame QLabel[textRole="pageMeta"] {
    background: transparent;
    border: none;
}

QFrame#topBarBrandDividerFrame,
QFrame#topBarProfileDividerFrame {
    background: #E3EAF4;
    border: none;
}

QFrame#pageCanvasFrame[surface="canvas"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #F8FBFF, stop:1 #EEF4FC);
    border: 1px solid #DEE7F2;
    border-radius: 0px;
}

QFrame#pageCanvasFrame[surface="canvas"][shellShape="rounded"] {
    border-radius: 14px;
}

QFrame#sidebarNavFrame,
QFrame#sidebarStackFrame,
QFrame#sidebarNavTopSpacer,
QFrame#sidebarBottomFrame,
QFrame#topBarContentFrame,
QFrame#topBarLeftFrame,
QFrame#topBarRightFrame,
QFrame#topBarActionsFrame,
QFrame#sidebarNavListFrame,
QFrame#headerContextFrame,
QFrame#headerActionsFrame,
QFrame#pageViewportFrame {
    background: transparent;
    border: none;
}

QFrame#sidebarUtilityFrame[surface="sidebarUtility"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #FFFFFF, stop:1 #F7FAFE);
    border: 1px solid #E2EAF4;
    border-radius: 24px;
}

QFrame#headerActionClusterFrame[surface="actionCluster"] {
    background: transparent;
    border: none;
    border-radius: 0px;
}

QLabel[textRole="brandMark"] {
    background: transparent;
    color: #FFFFFF;
    font-size: 13.8pt;
    font-weight: 800;
}

QLabel[textRole="sidebarKicker"] {
    color: #6C7D99;
    font-size: 8.2pt;
    font-weight: 700;
}

QLabel[textRole="brandAccent"] {
    color: #1F61ED;
    font-size: 15.8pt;
    font-weight: 800;
}

QLabel[textRole="brandWord"] {
    color: #172538;
    font-size: 15.8pt;
    font-weight: 700;
}

QLabel[textRole="sidebarMeta"] {
    color: #7D8A9C;
    font-size: 8.9pt;
    font-weight: 500;
}

QLabel[textRole="headerContext"] {
    color: #7C8A9B;
    font-size: 8.5pt;
    font-weight: 700;
}

QLabel[textRole="headerTitle"] {
    color: #132134;
    font-size: 17.4pt;
    font-weight: 700;
}

QLabel#topBarTitleLabel[textRole="headerTitle"] {
    font-size: 14.8pt;
    font-weight: 600;
}

QLabel#topBarTitleCaretLabel[textRole="pageMeta"] {
    color: #6B7B91;
    font-size: 10pt;
    font-weight: 700;
}

QLabel[textRole="navSection"] {
    color: #8E9DB1;
    font-size: 8pt;
    font-weight: 700;
    padding: 0 10px 4px 10px;
}

QLabel[textRole="pageTitle"] {
    color: #17263C;
    font-size: 22pt;
    font-weight: 700;
}

QLabel[textRole="pageMeta"] {
    color: #7B8798;
    font-size: 9pt;
    font-weight: 600;
}

QLabel[textRole="metricTitle"] {
    color: rgba(255, 255, 255, 0.86);
    font-size: 9pt;
    font-weight: 700;
}

QFrame[surface="metric"][accent="slate"] QLabel[textRole="metricTitle"] {
    color: #6C7A8E;
}

QLabel[textRole="caption"] {
    color: #8291A6;
    font-size: 9pt;
    font-weight: 600;
}

QLabel[textRole="muted"] {
    color: #6D7B8F;
}

QLabel[textRole="labelTitle"] {
    color: #516074;
    font-weight: 600;
}

QLabel[textRole="sectionTitle"] {
    color: #17263C;
    font-size: 11.3pt;
    font-weight: 700;
}

QLabel[textRole="tableHeader"] {
    color: #93A0B4;
    font-size: 8.8pt;
    font-weight: 700;
}

QLabel[textRole="feedText"] {
    color: #23324A;
    font-weight: 600;
}

QLabel[textRole="banner"] {
    color: #9A610D;
    font-weight: 700;
}

QLabel[textRole="dangerText"] {
    color: #DA5B52;
    font-weight: 600;
}

QLabel[textRole="timelineTitle"] {
    color: #314256;
    font-weight: 700;
}

QLabel[textRole="timelineMeta"] {
    color: #7F8CA1;
}

QLabel[textRole="chartValue"] {
    color: #17263C;
    font-size: 11.5pt;
    font-weight: 700;
}

QLabel[objectName*="ValueLabel"] {
    background: transparent;
    color: #17263C;
    font-size: 18pt;
    font-weight: 700;
}

QFrame[surface="metric"][accent="blue"] QLabel[objectName*="ValueLabel"],
QFrame[surface="metric"][accent="teal"] QLabel[objectName*="ValueLabel"],
QFrame[surface="metric"][accent="amber"] QLabel[objectName*="ValueLabel"] {
    color: #FFFFFF;
}

QPushButton[navItem="true"] {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 18px;
    color: #5E6E85;
    font-size: 10.5pt;
    font-weight: 600;
    min-height: 48px;
    padding: 0 14px;
    text-align: left;
}

QPushButton[navItem="true"]:hover {
    background: rgba(255, 255, 255, 0.76);
    border-color: rgba(47, 107, 255, 0.12);
    color: #162336;
}

QPushButton[navItem="true"]:pressed {
    background: rgba(47, 107, 255, 0.08);
}

QPushButton[navItem="true"][navKind="utility"] {
    min-height: 44px;
    background: #F9FBFE;
    border-color: #E2EAF3;
}

QPushButton[navItem="true"][navKind="utility"]:hover {
    background: #F3F8FF;
    border-color: #D6E0F1;
}

QPushButton[navItem="true"][active="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1E61EE, stop:1 #4D90FF);
    border: 1px solid #1E61EE;
    color: #FFFFFF;
    font-weight: 700;
}

QPushButton[navItem="true"][active="true"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #195AE2, stop:1 #4387F8);
}

QFrame#topBarFrame QPushButton,
QFrame#headerActionClusterFrame QPushButton {
    min-height: 40px;
    border-radius: 14px;
    padding: 0 14px;
}

QFrame#headerActionClusterFrame QPushButton {
    font-size: 10.5pt;
    min-width: 102px;
}

QPushButton[buttonRole="profile"] {
    min-width: 96px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FBFCFF, stop:1 #F4F7FB);
    border-color: #E0E7F1;
    color: #55657A;
}

QPushButton[buttonRole="profile"]:hover {
    background: #FFFFFF;
    border-color: #D4DEEB;
    color: #1F2B3C;
}

QPushButton[buttonRole="status"] {
    min-width: 154px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #4CB878, stop:1 #39A768);
    border: 1px solid #39A768;
    color: #FFFFFF;
    font-weight: 700;
}

QPushButton[buttonRole="status"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #46AE73, stop:1 #339C61);
    border-color: #339C61;
    color: #FFFFFF;
}

QPushButton#adminProfileButton[buttonRole="profile"] {
    min-width: 92px;
    padding: 0 14px;
}

QGroupBox[surface="card"],
QGroupBox[surface="soft"],
QFrame[surface="card"],
QFrame[surface="toolbar"],
QFrame[surface="soft"],
QFrame[surface="metric"],
QFrame[surface="warehouse"],
QFrame[surface="banner"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:1 #FAFCFF);
    border: 1px solid #D9E2EF;
    border-radius: 14px;
}

QFrame[surface="toolbar"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:1 #F8FBFF);
    border-color: #DEE6F2;
}

QFrame[surface="soft"],
QGroupBox[surface="soft"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FBFDFF, stop:1 #F2F6FD);
    border-color: #E0E8F4;
}

QFrame[surface="banner"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #FFF8EC, stop:1 #FFF1DE);
    border-color: #F0DEC1;
}

QFrame[surface="warehouse"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:1 #FAFCFF);
}

QFrame[surface="warehouse"][accent="w1"] { border-color: #D9E5FF; }
QFrame[surface="warehouse"][accent="w2"] { border-color: #D6EFE4; }
QFrame[surface="warehouse"][accent="w3"] { border-color: #F4E1C3; }
QFrame[surface="warehouse"][accent="w4"] { border-color: #E8DBFF; }
QFrame[surface="warehouse"][accent="w5"] { border-color: #D8EBF0; }

QFrame[surface="metric"] {
    min-height: 120px;
    border: 1px solid #D6DFF0;
    border-radius: 16px;
}

QFrame[surface="metric"][accent="blue"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #5B98FF, stop:1 #2F6BFF);
    border-color: #C5D8FF;
}

QFrame[surface="metric"][accent="teal"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #7CDCCF, stop:1 #49B8A8);
    border-color: #C3EBE5;
}

QFrame[surface="metric"][accent="amber"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #FFD381, stop:1 #F2A53C);
    border-color: #F5DBA3;
}

QFrame[surface="metric"][accent="slate"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #FFFFFF, stop:1 #F3F7FD);
    border-color: #DBE4F0;
}

QFrame[surface="metric"][accent="blue"] QLabel,
QFrame[surface="metric"][accent="teal"] QLabel,
QFrame[surface="metric"][accent="amber"] QLabel {
    color: #FFFFFF;
}

QGroupBox[surface] {
    margin-top: 28px;
    padding-top: 20px;
}

QGroupBox[surface]::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 18px;
    padding: 0 6px;
    color: #17263C;
    font-size: 12pt;
    font-weight: 700;
    background: transparent;
}

QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:1 #F7FAFD);
    border: 1px solid #D9E1EE;
    border-radius: 13px;
    color: #314357;
    font-size: 10pt;
    font-weight: 600;
    min-height: 40px;
    padding: 0 16px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:1 #F2F7FD);
    border-color: #CAD5E7;
    color: #22324A;
}

QPushButton:pressed {
    background: #EDF2F8;
}

QPushButton:disabled {
    background: #F4F6FA;
    border-color: #E3E9F3;
    color: #9AA6B7;
}

QPushButton[buttonRole="primary"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2563EB, stop:1 #4387FF);
    border-color: #2563EB;
    color: #FFFFFF;
}

QPushButton[buttonRole="primary"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1F5CDD, stop:1 #3C81F9);
}

QPushButton[buttonRole="success"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #20B56C, stop:1 #37C47C);
    border-color: #1EA360;
    color: #FFFFFF;
}

QPushButton[buttonRole="success"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1CA660, stop:1 #30B572);
}

QPushButton[buttonRole="danger"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #EF6262, stop:1 #E54D4D);
    border-color: #E34C4C;
    color: #FFFFFF;
}

QPushButton[buttonRole="danger"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #E45757, stop:1 #D94343);
}

QPushButton[buttonRole="secondary"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:1 #F8FAFD);
    border-color: #E0E7F2;
    color: #506076;
}

QFrame#headerActionClusterFrame QPushButton[buttonRole="secondary"] {
    background: #FFFFFF;
    border-color: #E1E8F2;
    color: #43536A;
}

QFrame#headerActionClusterFrame QPushButton[buttonRole="secondary"]:hover {
    background: #F7FAFF;
    border-color: #D4DEEE;
    color: #1D2B3D;
}

QFrame#headerActionClusterFrame QPushButton[buttonRole="primary"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1E61EE, stop:1 #498CFF);
    border-color: #1E61EE;
}

QFrame#headerActionClusterFrame QPushButton[buttonRole="primary"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #195AE2, stop:1 #4083F7);
}

QFrame#headerActionClusterFrame QPushButton[buttonRole="danger"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #F06A6A, stop:1 #E45454);
    border-color: #E45454;
}

QFrame#headerActionClusterFrame QPushButton[buttonRole="danger"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #E65D5D, stop:1 #DB4848);
}

QPushButton[buttonRole="page"] {
    background: #FFFFFF;
    border-color: #E2E8F3;
    border-radius: 10px;
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
    padding: 0;
}

QPushButton[buttonRole="pageActive"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2F6BFF, stop:1 #4A8EFF);
    border-color: #2F6BFF;
    border-radius: 10px;
    color: #FFFFFF;
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
    padding: 0;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QDateEdit,
QAbstractSpinBox {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FBFCFF, stop:1 #F6F9FD);
    border: 1px solid #D8E1EE;
    border-radius: 13px;
    color: #22324A;
    min-height: 40px;
    padding: 0 12px;
    selection-background-color: #DDE8FF;
    selection-color: #22324A;
}

QTextEdit,
QPlainTextEdit {
    padding: 10px 12px;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QDateEdit:focus,
QAbstractSpinBox:focus {
    background: #FFFFFF;
    border: 1px solid #2F6BFF;
}

QLineEdit:read-only,
QTextEdit:read-only {
    background: #F4F7FC;
    color: #5D6A7D;
}

QComboBox::drop-down,
QDateEdit::drop-down {
    border: none;
    width: 28px;
}

QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
    width: 18px;
    border: none;
    background: transparent;
}

QCheckBox {
    background: transparent;
    color: #4C5B70;
    spacing: 10px;
    font-weight: 500;
}

QCheckBox::indicator {
    width: 34px;
    height: 20px;
    border-radius: 10px;
    border: 1px solid #D4DCE8;
    background: #E5EBF4;
}

QCheckBox::indicator:checked {
    background: #43BE87;
    border-color: #36B37A;
}

QLabel[badgeRole] {
    background: #EEF4FF;
    border: 1px solid #D4E0FA;
    border-radius: 12px;
    color: #3361CB;
    font-weight: 700;
    min-height: 24px;
    padding: 0 10px;
}

QLabel[badgeRole="success"] {
    background: #E9F9F0;
    border-color: #CCEFDA;
    color: #1C8F57;
}

QLabel[badgeRole="fail"],
QLabel[badgeRole="error"],
QLabel[badgeRole="danger"] {
    background: #FFF1F0;
    border-color: #F5D3D0;
    color: #D54C43;
}

QLabel[badgeRole="warning"],
QLabel[badgeRole="locked"],
QLabel[badgeRole="amber"] {
    background: #FFF6E3;
    border-color: #F4E2BD;
    color: #C98316;
}

QLabel[badgeRole="idle"] {
    background: #F3F6FB;
    border-color: #E4EAF2;
    color: #667489;
}

QLabel[badgeRole="running"],
QLabel[badgeRole="info"] {
    background: #EAF2FF;
    border-color: #D8E5FF;
    color: #2F6BFF;
}

QLabel[badgeRole="base"] {
    background: #EBF8EE;
    border-color: #D5EDD8;
    color: #2B9956;
}

QLabel[badgeRole="taxed"] {
    background: #EEF6FF;
    border-color: #D8E7FB;
    color: #2F6BFF;
}

QLabel[badgeRole="discounted"] {
    background: #FFF4E5;
    border-color: #F6E0BC;
    color: #D37D11;
}

QLabel[badgeRole="w1"] { background: #EAF2FF; border-color: #D8E5FF; color: #2F6BFF; }
QLabel[badgeRole="w2"] { background: #E8F8F0; border-color: #D0EFE0; color: #1B8E57; }
QLabel[badgeRole="w3"] { background: #FFF4E8; border-color: #F5DFC5; color: #CA7B12; }
QLabel[badgeRole="w4"] { background: #F4EEFF; border-color: #E3D7FF; color: #6D51D8; }
QLabel[badgeRole="w5"] { background: #EAF8FB; border-color: #D7EDF3; color: #0E7C92; }

QLabel#headerStatusLabel {
    min-height: 36px;
    border-radius: 18px;
    font-size: 8.8pt;
    padding: 0 14px;
}

QLabel#headerStatusLabel[badgeRole="success"] {
    background: #E9F8F0;
    border-color: #CBEED9;
    color: #177F4E;
}

QLabel#headerStatusLabel[badgeRole="warning"] {
    background: #FFF6E4;
    border-color: #F2E0BB;
    color: #B77A14;
}

QLabel#headerStatusLabel[badgeRole="info"] {
    background: #ECF3FF;
    border-color: #D7E5FF;
    color: #2F6BFF;
}

QFrame#badgeDot {
    background: #2F6BFF;
    border-radius: 4px;
}

QFrame#badgeDot[badgeRole="success"] { background: #1C8F57; }
QFrame#badgeDot[badgeRole="fail"],
QFrame#badgeDot[badgeRole="error"],
QFrame#badgeDot[badgeRole="danger"] { background: #D54C43; }
QFrame#badgeDot[badgeRole="warning"],
QFrame#badgeDot[badgeRole="locked"],
QFrame#badgeDot[badgeRole="amber"] { background: #C98316; }
QFrame#badgeDot[badgeRole="idle"] { background: #94A3B8; }
QFrame#badgeDot[badgeRole="running"],
QFrame#badgeDot[badgeRole="info"] { background: #2F6BFF; }
QFrame#badgeDot[badgeRole="base"] { background: #2B9956; }
QFrame#badgeDot[badgeRole="taxed"] { background: #2F6BFF; }
QFrame#badgeDot[badgeRole="discounted"] { background: #D37D11; }
QFrame#badgeDot[badgeRole="w1"] { background: #2F6BFF; }
QFrame#badgeDot[badgeRole="w2"] { background: #1B8E57; }
QFrame#badgeDot[badgeRole="w3"] { background: #CA7B12; }
QFrame#badgeDot[badgeRole="w4"] { background: #6D51D8; }
QFrame#badgeDot[badgeRole="w5"] { background: #0E7C92; }

QTableWidget {
    background: transparent;
    border: none;
    gridline-color: transparent;
    alternate-background-color: #FBFCFF;
    selection-background-color: #DCE8FF;
    selection-color: #22324A;
    outline: 0;
}

QTableWidget::item {
    background: transparent;
    border-bottom: 1px solid #EEF2F7;
    padding: 8px 10px;
}

QTableWidget::item:selected {
    background: #DCE8FF;
    color: #22324A;
}

QHeaderView::section,
QTableCornerButton::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FBFCFE, stop:1 #F4F7FB);
    border: none;
    border-bottom: 1px solid #E7EDF6;
    color: #8794A7;
    font-size: 8.8pt;
    font-weight: 700;
    min-height: 40px;
    padding: 0 12px;
    text-align: left;
}

QWidget#feedRowWidget,
QWidget#timelineItemWidget {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FBFCFF, stop:1 #F6F9FD);
    border: 1px solid #E6ECF5;
    border-radius: 14px;
}

QFrame#chartCanvasFrame {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:1 #FAFCFF);
    border: 1px solid #E5EBF4;
    border-radius: 18px;
}

QLabel#chartLegendSwatch {
    min-width: 10px;
    max-width: 10px;
    min-height: 10px;
    max-height: 10px;
    border-radius: 5px;
}

QLabel#chartLegendSwatch[swatchRole="blue"] { background: #5B98FF; }
QLabel#chartLegendSwatch[swatchRole="teal"] { background: #68C9BF; }
QLabel#chartLegendSwatch[swatchRole="amber"] { background: #F3B14F; }
QLabel#chartLegendSwatch[swatchRole="red"] { background: #F26666; }

QWidget#productCellWidget {
    border: none;
}

QLabel#productIconLabel {
    color: #73839B;
}

QLabel#productCellIdLabel {
    color: #34465D;
    font-size: 10.5pt;
    font-weight: 700;
}

QTextEdit#logDetailsTextEdit {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FCFDFF, stop:1 #F7FAFE);
    border: 1px solid #DCE5F2;
    border-radius: 14px;
    color: #4B5563;
}

QLabel[surface="placeholder"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #FBFCFF, stop:1 #F1F6FF);
    border: 1px dashed #D5E3FA;
    border-radius: 18px;
    color: #6B7280;
    font-size: 10pt;
    padding: 18px;
}

QLabel#stockValueLabel {
    font-weight: 700;
}

QLabel#stockValueLabel[stockTone="high"] { color: #1E9E57; }
QLabel#stockValueLabel[stockTone="medium"] { color: #D48A16; }
QLabel#stockValueLabel[stockTone="low"] { color: #EF4444; }

QFrame#stockBarTrack {
    background: #EEF2F7;
    border: none;
    border-radius: 4px;
}

QFrame#stockBarFill {
    border: none;
    border-radius: 4px;
}

QFrame#stockBarFill[stockTone="high"] { background: #32C46C; }
QFrame#stockBarFill[stockTone="medium"] { background: #FDBA3B; }
QFrame#stockBarFill[stockTone="low"] { background: #F0645A; }

QScrollArea {
    border: none;
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    margin: 6px 0;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #CCD6E5;
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #B5C4D8;
}

QScrollBar:horizontal {
    background: transparent;
    margin: 0 6px;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background: #CCD6E5;
    border-radius: 5px;
    min-width: 28px;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    border: none;
}

QSplitter::handle {
    background: transparent;
}

QSplitter::handle:horizontal {
    width: 12px;
}

QSplitter::handle:horizontal:hover {
    background: rgba(47, 107, 255, 0.10);
    border-radius: 6px;
}

