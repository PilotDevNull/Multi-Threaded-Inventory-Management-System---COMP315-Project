}

QWidget#InventoryPage QWidget#inventoryTableViewport,
QWidget#InventoryPage QWidget#importPreviewViewport {
    background: #FFFFFF;
    border: none;
}

QWidget#InventoryPage QGroupBox#inventoryTableGroupBox QHeaderView::section,
QWidget#InventoryPage QGroupBox#importGroupBox QHeaderView::section,
QWidget#InventoryPage QGroupBox#inventoryTableGroupBox QTableCornerButton::section,
QWidget#InventoryPage QGroupBox#importGroupBox QTableCornerButton::section {
    background: #F8FBFF;
    border: none;
    border-bottom: 1px solid #E9EEF6;
    color: #506178;
    font-size: 9.8pt;
    font-weight: 700;
    min-height: 42px;
    padding: 0 12px;
}

QWidget#InventoryPage QTableWidget#inventoryTableWidget::item {
    background: transparent;
    border-bottom: 1px solid #EEF2F7;
    padding: 10px 12px;
}
QWidget#InventoryPage QWidget#productCellWidget,
QWidget#InventoryPage QWidget#stockCell {
    border: none;
}
QWidget#InventoryPage QWidget#productCellWidget[rowBand="odd"],
QWidget#InventoryPage QWidget#stockCell[rowBand="odd"] {
    background: #FFFFFF;
}
QWidget#InventoryPage QWidget#productCellWidget[rowBand="even"],
QWidget#InventoryPage QWidget#stockCell[rowBand="even"] {
    background: #FBFCFF;
}
QWidget#InventoryPage QWidget#productCellWidget[selected="true"],
QWidget#InventoryPage QWidget#stockCell[selected="true"] {
    background: #DCE8FF;
}
QWidget#InventoryPage QWidget#productCellWidget QLabel,
QWidget#InventoryPage QWidget#stockCell QLabel {
    background: transparent;
}

QWidget#InventoryPage QLabel#stockValueLabel {
    font-size: 9.2pt;
}

QWidget#InventoryPage QTableWidget#importPreviewTableWidget::item {
    background: transparent;
    border-bottom: 1px solid #EEF2F7;
    padding: 8px 12px;
}

QWidget#InventoryPage QGroupBox#editorGroupBox QLineEdit,
QWidget#InventoryPage QGroupBox#editorGroupBox QComboBox,
QWidget#InventoryPage QGroupBox#editorGroupBox QAbstractSpinBox {
    min-height: 40px;
}

QWidget#InventoryPage QGroupBox#editorGroupBox QLineEdit:read-only,
QWidget#InventoryPage QGroupBox#editorGroupBox QAbstractSpinBox:read-only,
QWidget#InventoryPage QGroupBox#editorGroupBox QComboBox:disabled,
QWidget#InventoryPage QLineEdit#csvPathLineEdit {
    background: #F4F7FC;
    border: 1px solid #DEE6F1;
    color: #55657A;
}

QWidget#InventoryPage QSpinBox#productIdSpinBox[rowSelected="true"],
QWidget#InventoryPage QSpinBox#productQuantitySpinBox[rowSelected="true"] {
    background: #EAF1FF;
    border: 1px solid #BCD0F8;
}

QWidget#InventoryPage QGroupBox#editorGroupBox QPushButton {
    min-height: 42px;
    font-size: 10.6pt;
}

QWidget#InventoryPage QLineEdit#inventorySearchLineEdit:disabled,
QWidget#InventoryPage QComboBox#sortComboBox:disabled,
QWidget#InventoryPage QPushButton#filterButton:disabled,
QWidget#InventoryPage QCheckBox#lowStockOnlyCheckBox:disabled,
QWidget#InventoryPage QGroupBox#editorGroupBox QPushButton:disabled,
QWidget#InventoryPage QGroupBox#importGroupBox QPushButton:disabled {
    background: #F6F8FC;
    border-color: #E1E8F2;
    color: #8C98AB;
}

QWidget#InventoryPage QCheckBox#lowStockOnlyCheckBox:disabled {
    color: #8090A6;
}

QWidget#InventoryPage QPushButton#addProductButton {
    font-weight: 700;
}

QWidget#InventoryPage QPushButton#removeProductButton {
    background: #FFFFFF;
    border: 1px solid #F3B7B2;
    color: #EF4444;
}

QWidget#InventoryPage QPushButton#removeProductButton:hover {
    background: #FFF6F5;
    border-color: #EB9F98;
    color: #E43F3F;
}

QWidget#InventoryPage QRadioButton {
    background: transparent;
    color: #3D4E65;
    font-size: 10.2pt;
    font-weight: 500;
    spacing: 8px;
}

QWidget#InventoryPage QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 1px solid #C9D4E3;
    background: #FFFFFF;
}

QWidget#InventoryPage QRadioButton::indicator:checked {
    background: #2F6BFF;
    border: 1px solid #2F6BFF;
}

QWidget#InventoryPage QRadioButton:checked {
    color: #1F3048;
    font-weight: 700;
}

QWidget#InventoryPage QFrame#editorNotesFrame {
    background: #F8FBFF;
    border: 1px solid #E5ECF6;
    border-radius: 16px;
}

QWidget#InventoryPage QFrame#editorNotesFrame QLabel[badgeRole] {
    min-height: 28px;
    border-radius: 10px;
    font-size: 9.2pt;
    padding: 0 10px;
}

QWidget#InventoryPage QFrame#statusFrame QLabel[badgeRole] {
    min-height: 28px;
    border-radius: 10px;
    font-size: 9.2pt;
    padding: 0 12px;
}

QWidget#InventoryPage QFrame#statusFrame QLabel[textRole="labelTitle"] {
    background: transparent;
    color: #5F7086;
    font-size: 9pt;
    font-weight: 700;
}
